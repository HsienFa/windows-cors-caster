# NTRIP Caster 安全設定範例
# Windows 請複製為 config.windows.local.ini；手動 Linux 部署可複製為 config.ini。
# Docker 與 install.sh 會另行建立安全執行設定，不會直接執行此佔位範例。
# 相對路徑會以專案根目錄為基準，Windows 與 Linux 均可使用。

[app]
name = Ntrip Caster
version = 2.2.0
description = Ntrip Caster
author =
contact =
website =

[caster]
country = CHN
latitude = 25.20341154
longitude = 110.277492

[development]
debug_mode = false

[network]
# 安全預設只接受本機連線；確有需要時才改為對外監聽位址。
host = 127.0.0.1
max_connections = 1000
buffer_size = 81920
max_buffer_size = 655360

[ntrip]
host = 127.0.0.1
port = 2101
supported_versions = 1.0,2.0
default_version = 1.0
max_user_connections_per_mount = 3000
max_users_per_mount = 3000
max_connections_per_user = 3
mount_timeout = 1800
client_timeout = 300
connection_timeout = 1800

[web]
host = 127.0.0.1
port = 5757
realtime_push_interval = 3
system_status_interval = 1
page_refresh_interval = 30

[map]
# 預設使用 OpenStreetMap；只有設為 google 且提供金鑰時才載入 Google Maps。
provider = osm
google_maps_api_key =
default_latitude = 23.7
default_longitude = 121.0
default_zoom = 7

[database]
# 相对路径会解析为 <项目根目录>/data/2rtk.db
path = data/2rtk.db
pool_size = 10
timeout = 30

[logging]
# 相对路径会解析为 <项目根目录>/logs
log_dir = logs
main_log_file = main.log
ntrip_log_file = ntrip.log
error_log_file = errors.log
log_level = WARNING
log_format = %%(asctime)s - %%(name)s - %%(levelname)s - %%(message)s
max_log_size = 10485760
backup_count = 5
log_frequent_status = false

[security]
# 必須替換為使用 Python secrets 產生、至少 32 個字元的隨機值。
secret_key = REPLACE_WITH_RANDOM_SECRET_KEY
password_hash_rounds = 3
session_timeout = 3600

[admin]
# 必須替換為僅供本機使用的強密碼。
username = admin
password = REPLACE_WITH_STRONG_ADMIN_PASSWORD

[tcp]
keepalive_enabled = true
keepalive_idle = 60
keepalive_interval = 10
keepalive_count = 3
socket_timeout = 120

[data_forwarding]
ring_buffer_size = 60
broadcast_interval = 0.01
data_send_timeout = 5
client_health_check_interval = 120

[rtcm]
parse_interval = 5
buffer_size = 1000
parse_duration = 30

[websocket]
ping_timeout = 120
ping_interval = 15
enabled = true

[performance]
thread_pool_size = 100
max_workers = 100
connection_queue_size = 1000
max_memory_usage = 2048
cpu_warning_threshold = 80
memory_warning_threshold = 80
