# Docker Compose local environment example
#
# Copy this file to .env. The .env file is ignored by Git and must be readable
# only by the deployment administrator. Never commit its credential values.

COMPOSE_PROJECT_NAME=ntrip-caster
ENVIRONMENT=development

# Optional Compose profiles: nginx, monitoring, cache (comma-separated).
COMPOSE_PROFILES=

# NTRIP is intentionally published on all host interfaces by default. Restrict
# this address or use a firewall unless remote base stations and users need it.
NTRIP_PUBLISH_HOST=0.0.0.0

# Web administration, optional reverse proxy, monitoring and cache ports stay
# host-local by default.
WEB_PUBLISH_HOST=127.0.0.1
NGINX_PUBLISH_HOST=127.0.0.1
MONITORING_PUBLISH_HOST=127.0.0.1
CACHE_PUBLISH_HOST=127.0.0.1

# The first NTRIP container start requires a private administrator password.
# quick-start.sh can generate it directly into the ignored .env without
# displaying it. Direct Compose users must set it before the first start.
NTRIP_ADMIN_USERNAME=admin
NTRIP_ADMIN_PASSWORD=

# Required only when the monitoring profile is enabled. Empty or unsafe values
# are rejected by the Grafana container before Grafana starts.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Optional Google Maps browser key. Keep provider=osm and the key blank to use
# OpenStreetMap without loading Google services.
MAP_PROVIDER=osm
GOOGLE_MAPS_API_KEY=

TZ=Asia/Taipei
